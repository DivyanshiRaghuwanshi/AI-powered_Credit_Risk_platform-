# PostgreSQL Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Neo4j Graph Database Settings
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ==========================================
# LLM Configurations (Choose your provider)
# ==========================================

# Active Provider Settings (Groq Default Example)
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# ALTERNATIVE: Google Gemini API
# To use Gemini, uncomment the lines below:
# OPENAI_API_KEY=your_gemini_api_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-1.5-flash

# ALTERNATIVE: OpenAI API
# To use standard OpenAI, uncomment the lines below:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# ==========================================
# Path and Registry Settings
# ==========================================
RAW_DATA_DIR=data/raw
LIME_MODEL_DIR=models
RULE_REGISTRY_PATH=models/approved_rules.json
PHASE4_LATEST_MODEL_FILE=latest_model_id.txt
APP_LOG_FILE=logs/app.log

PHASE3_SQL_TABLE=master_ews_fibo
PGVECTOR_TABLE=risk_documents
PGVECTOR_EMBEDDING_COL=embedding
