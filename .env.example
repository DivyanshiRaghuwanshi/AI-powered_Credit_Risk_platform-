# PostgreSQL Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Neo4j Graph Database Settings
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ==========================================
# LLM API Keys (Set your preferred key)
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model override (leave blank for defaults: Groq=llama-3.3-70b-versatile, Gemini=gemini-1.5-flash, OpenAI=gpt-4o-mini)
OPENAI_MODEL=

# ==========================================
# Path and Registry Settings
# ==========================================
RAW_DATA_DIR=data/raw
LIME_MODEL_DIR=models
RULE_REGISTRY_PATH=models/approved_rules.json
PHASE4_LATEST_MODEL_FILE=latest_model_id.txt
APP_LOG_FILE=logs/app.log

PHASE3_SQL_TABLE=master_ews_fibo
PGVECTOR_TABLE=risk_documents
PGVECTOR_EMBEDDING_COL=embedding
